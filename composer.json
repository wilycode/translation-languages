{
    "name": "wilycode/translation-languages",
    "description": "Language pluralization rules and configurable locale formatting resources for WilyCode Translation.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "wilycode/translation": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\Translation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\Translation\\Languages\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/docs",
            "/benchmark",
            "/benchmarks",
            "/tools",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/CHANGELOG.md",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md",
            "/SECURITY.md",
            "/composer.lock",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon",
            "/phpstan.neon.dist",
            "/phpstan.*.neon",
            "/phpstan.*.neon.dist",
            "/pint.json",
            "/rector.php",
            "/psalm.xml",
            "/psalm.xml.dist",
            "/infection.json",
            "/infection.json.dist"
        ]
    },
    "keywords": [
        "translation",
        "localization",
        "i18n",
        "l10n",
        "pluralization",
        "language",
        "locale",
        "formatter",
        "wilycode"
    ],
    "homepage": "https://github.com/wilycode/translation-languages",
    "support": {
        "issues": "https://github.com/wilycode/translation-languages/issues",
        "source": "https://github.com/wilycode/translation-languages"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    }
}
